# Nunca envie seu token no chat. Configure somente neste computador.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_ID=
DISCORD_ADMIN_ROLE_ID=
# tcp: apenas alcançabilidade TCP. process: inicia o Vanilla nesta máquina.
TERRARIA_MODE=tcp
TERRARIA_HOST=127.0.0.1
TERRARIA_PORT=7777
# Vazio oculta o endereço no Discord; preencha somente se desejar divulgar.
TERRARIA_PUBLIC_HOST=
# Executável nativo, não .bat/.sh. Caminhos absolutos ou relativos a este projeto.
TERRARIA_EXECUTABLE=
TERRARIA_CONFIG=
# Opcional, somente para mascarar saída. Senha real fica no serverconfig.txt.
TERRARIA_PASSWORD=
POLL_SECONDS=10
